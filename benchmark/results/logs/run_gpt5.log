D: s.DTXSID, Name: s.Name, fish_cnt: cnt}) AS fish_rows,\n         percentileDisc(cnt, 0.99) AS p99_fish\n}\nWITH topA, topC, fish_rows, p99_fish\nUNWIND fish_rows AS f\nWITH topA, topC, p99_fish, f\nWHERE f.fish_cnt >= p99_fish\nWITH topA, topC, collect({DTXSID: f.DTXSID, Name: f.Name, fish_cnt: f.fish_cnt}) AS topF\nUNWIND topA AS a\nUNWIND topC AS c\nUNWIND topF AS f\nWITH a, c, f\nWHERE a.DTXSID = c.DTXSID AND a.DTXSID = f.DTXSID\nRETURN a.DTXSID AS DTXSID,\n       a.Name AS ChemicalName,\n       a.algae_cnt AS count_exceedances_algae,\n       c.crust_cnt AS count_exceedances_crustacean,\n       f.fish_cnt AS count_exceedances_fish\nORDER BY (a.algae_cnt + c.crust_cnt + f.fish_cnt) DESC, ChemicalName'
