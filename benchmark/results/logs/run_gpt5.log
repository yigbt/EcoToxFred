  AND tox_crustacean >= 10 * tox_fish
RETURN s.Name AS ChemicalName,
       toString(tox_fish) + ' mg/l' AS Fish_Toxicity,
       toString(tox_algae) + ' mg/l' AS Algae_Toxicity,
       toString(tox_crustacean) + ' mg/l' AS Crustacean_Toxicity
ORDER BY tox_fish ASC
LIMIT 20[0m

