[32;1m[1;3mCALL {
  // Top 20 river basins for algae by acute_rate
  MATCH (l:Site)-[r:SUMMARIZED_IMPACT_ON]->(sp:Species)
  WHERE sp.name = 'algae' AND r.sumTU IS NOT NULL AND l.river_basin IS NOT NULL
  WITH toLower(l.river_basin) AS river_basin, sp.name AS species,
       count(r) AS n_samples,
       sum(CASE WHEN r.sumTU > 1 THEN 1 ELSE 0 END) AS acute_exceedances,
       sum(CASE WHEN r.sumTU > 0.001 THEN 1 ELSE 0 END) AS chronic_exceedances
  WITH river_basin, species, n_samples, acute_exceedances, chronic_exceedances,
       (CASE WHEN n_samples > 0 THEN toFloat(acute_exceedances) / toFloat(n_samples) ELSE 0.0 END) AS acute_rate,
       (CASE WHEN n_samples > 0 THEN toFloat(chronic_exceedances) / toFloat(n_samples) ELSE 0.0 END) AS chronic_rate
  RETURN river_basin, species, n_samples, acute_exceedances, acute_rate, chronic_exceedances, chronic_rate
  ORDER BY acute_rate DESC
  LIMIT 20

  UNION ALL

  // Top 20 river basins for crustacean (daphnia) by acute_rate
  MATCH (l:Site)-[r:SUMMARIZED_IMPACT_ON]->(sp:Species)
  WHERE sp.name = 'crustacean' AND r.sumTU IS NOT NULL AND l.river_basin IS NOT NULL
  WITH toLower(l.river_basin) AS river_basin, sp.name AS species,
       count(r) AS n_samples,
       sum(CASE WHEN r.sumTU > 1 THEN 1 ELSE 0 END) AS acute_exceedances,
       sum(CASE WHEN r.sumTU > 0.001 THEN 1 ELSE 0 END) AS chronic_exceedances
  WITH river_basin, species, n_samples, acute_exceedances, chronic_exceedances,
       (CASE WHEN n_samples > 0 THEN toFloat(acute_exceedances) / toFloat(n_samples) ELSE 0.0 END) AS acute_rate,
       (CASE WHEN n_samples > 0 THEN toFloat(chronic_exceedances) / toFloat(n_samples) ELSE 0.0 END) AS chronic_rate
  RETURN river_basin, species, n_samples, acute_exceedances, acute_rate, chronic_exceedances, chronic_rate
  ORDER BY acute_rate DESC
  LIMIT 20

  UNION ALL

  // Top 20 river basins for fish by acute_rate
  MATCH (l:Site)-[r:SUMMARIZED_IMPACT_ON]->(sp:Species)
  WHERE sp.name = 'fish' AND r.sumTU IS NOT NULL AND l.river_basin IS NOT NULL
  WITH toLower(l.river_basin) AS river_basin, sp.name AS species,
       count(r) AS n_samples,
       sum(CASE WHEN r.sumTU > 1 THEN 1 ELSE 0 END) AS acute_exceedances,
       sum(CASE WHEN r.sumTU > 0.001 THEN 1 ELSE 0 END) AS chronic_exceedances
  WITH river_basin, species, n_samples, acute_exceedances, chronic_exceedances,
       (CASE WHEN n_samples > 0 THEN toFloat(acute_exceedances) / toFloat(n_samples) ELSE 0.0 END) AS acute_rate,
       (CASE WHEN n_samples > 0 THEN toFloat(chronic_exceedances) / toFloat(n_samples) ELSE 0.0 END) AS chronic_rate
  RETURN river_basin, species, n_samples, acute_exceedances, acute_rate, chronic_exceedances, chronic_rate
  ORDER BY acute_rate DESC
  LIMIT 20
}
