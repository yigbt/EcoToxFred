[32;1m[1;3mMATCH (s:Substance)-[r:MEASURED_AT]->(:Site)
WITH s, r
UNWIND [
  {species: 'algae', tu: r.TU_algae},
  {species: 'crustacean', tu: r.TU_crustacean},
  {species: 'fish', tu: r.TU_fish}
] AS sp
WITH s.Name AS substance_name, sp.species AS species, sp.tu AS tu
WHERE tu IS NOT NULL
WITH species, substance_name,
     count(*) AS total_measurements_for_substance_and_species,
     sum(CASE WHEN tu > 0.001 THEN 1 ELSE 0 END) AS exceed_count
WITH species, substance_name, exceed_count, total_measurements_for_substance_and_species,
     CASE
       WHEN total_measurements_for_substance_and_species > 0
       THEN toFloat(exceed_count) / toFloat(total_measurements_for_substance_and_species)
       ELSE 0.0
     END AS exceed_rate
ORDER BY species, exceed_count DESC, substance_name ASC
WITH species, collect({
  substance_name: substance_name,
  exceed_count: exceed_count,
  total: total_measurements_for_substance_and_species,
  rate: exceed_rate
}) AS rows
UNWIND rows[0..10] AS top
RETURN
  species,
  top.substance_name AS substance_name,
  top.exceed_count AS exceed_count,
  top.total AS total_measurements_for_substance_and_species,
  top.rate AS exceed_rate
ORDER BY species, exceed_count DESC, substance_name ASC[0m
